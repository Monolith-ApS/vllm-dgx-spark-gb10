# Settings of this model for the scripts in scripts/ (plain KEY=VALUE; bash sources it, docker compose reads it with --env-file).
# MODEL_NAME is the folder name: what scripts/*.sh take as argument.
MODEL_NAME=qwen3.8-flash-next
DISPLAY_NAME="Qwen3.8 Flash Next"
SERVED_NAME=qwen3.8-flash-next
HF_REPO=nvidia/Qwen3.8-Flash-Next-NVFP4
HF_REVISION=fc694b54fb0174e0913e6adf86691ef85a4ead47
WEIGHTS_DIR=Qwen3.8-Flash-Next-NVFP4
WEIGHTS_GB=133
NEED_GB=160
DEFAULT_PROFILE=512k-c3
# vLLM releases this model can be built on (one Dockerfile.vllm-<release> each) and the one used when VLLM is not set.
VLLM_RELEASES="0.31 0.32"
VLLM_DEFAULT=0.31
# Variables of serve.py that scripts/run.sh passes to the container when they are set (see configuration.md).
PASS_ENV="GMU MTP LOAD_FORMAT"
# Image that runs the Hugging Face download (scripts/get-model.sh); any vLLM image with the Hugging Face CLI works.
DOWNLOAD_IMAGE=vllm/vllm-openai:v0.31.0
